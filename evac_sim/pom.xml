<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.artemyasnik</groupId>
    <artifactId>evac-sim</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>evac_sim</name>
    <description> Парсер SVG-планов зданий (комнаты, коридоры, двери, аварийные выходы, лестницы) и сборка графа для моделирования эвакуации. Рантайм-зависимостей нет — только стандартный JDK (javax.xml / DOM). </description>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>com.artemyasnik.Main</main.class>
        <junit.version>5.10.2</junit.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!--  Быстрый запуск в дев-цикле: mvn exec:java  -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <!--  Runnable JAR: java -jar target/evac-sim-0.1.0-SNAPSHOT.jar  -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!--
        Когда парсер будет выделяться в отдельную библиотеку:
        1. Вынести пакеты model/, parser/, graph/ в новый модуль/репозиторий,
           оставив Main и examples/ в приложении.
        2. У библиотеки поменять artifactId (например, floorplan-parser) и убрать
           из pom maven-jar-plugin с mainClass и exec-maven-plugin — они нужны
           только исполняемому приложению.
        3. Для публикации добавить maven-source-plugin, maven-javadoc-plugin
           и <distributionManagement>.
       -->
</project>